# Copy to .env. All paths below are configurable and local to your machine.
JEV_ENDPOINT=http://127.0.0.1:8000/v1/systemone
JEV_MODEL=NeoHorse-Jev-4B
# Optional: bearer token for an authenticated decision service.
JEV_API_KEY=
VIEW_PORT=8080
DATA_DIR=./runs
EPISODE_SECONDS=120
START_SEED=1200
# conditions (default), free, effects, or legacy
DUEL_POLICY_MODE=conditions
# Linux headless rendering; use glfw on macOS.
MUJOCO_GL=egl
